        "source": "\\bgh[pousr]_[A-Za-z0-9]{20,}\\b",
        "flags": "g"
      },
      {
        "label": "github-pat",
        "source": "\\bgithub_pat_[A-Za-z0-9_]{20,}\\b",
        "flags": "g"
      },
      {
        "label": "aws-access-key-id",
        "source": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
        "flags": "g"
      },
      {
        "label": "google-api-key",
        "source": "\\bAIza[0-9A-Za-z_-]{35}\\b",
        "flags": "g"
      },
      {
        "label": "slack-token",
        "source": "\\bxox[abposr]-[A-Za-z0-9-]{10,}\\b",
        "flags": "g"
      },
      {
        "label": "gitlab-token",
        "source": "\\bglpat-[A-Za-z0-9_-]{20,}\\b",
        "flags": "g"
      },
      {
        "label": "npm-token",
        "source": "\\bnpm_[A-Za-z0-9]{36}\\b",
        "flags": "g"
      },
      {
        "label": "jwt",
        "source": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b",
        "flags": "g"
      },
      {
        "label": "wireguard-or-b64-key",
        "source": "(?<![A-Za-z0-9+/=])[A-Za-z0-9+/]{43}=(?![A-Za-z0-9+/=])",
        "flags": "g"
      },
      {
        "label": "url-basic-auth",
        "source": "(?<=://)([^/\\s:@]{1,64}):([^/\\s@]{1,128})@",
        "flags": "g"
      },
      {
        "label": "cli-secret-flag",
        "source": "(?<![\\w-])--?(?:password|passwd|pass|token|api[-_]?key|secret|auth)[= ]\\s*(\"[^\"]*\"|'[^']*'|\\S+)",
        "flags": "gi"
      },
      {
        "label": "auth-header",
        "source": "\\b(?:authorization|proxy-authorization)\\s*:\\s*(?:bearer|basic|token)\\s+\\S+",
        "flags": "gi"
      },
      {
        "label": "env-assignment",
        "source": "\\b([A-Z][A-Z0-9_]*(?:TOKEN|SECRET|PASSWORD|PASSWD|APIKEY|API_KEY|PRIVATE_KEY|ACCESS_KEY|CREDENTIALS?|COOKIE)[A-Z0-9_]*)\\s*[:=]\\s*(\"[^\"]*\"|'[^']*'|[^\\s;&|]{4,})",
        "flags": "g"
      },
      {
        "label": "connection-string",
        "source": "\\b(?:mongodb(?:\\+srv)?|postgres(?:ql)?|mysql|redis|amqp|clickhouse)://\\S+",
        "flags": "gi"
      },
      {
        "label": "stripe-key",
        "source": "\\b(?:sk|rk)_live_[A-Za-z0-9]{16,}\\b",
        "flags": "g"
      }
